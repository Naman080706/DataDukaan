# Backend only, never exposed to the browser. At least one AI key is recommended;
# with none, the app still answers common questions with the offline rule engine.

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key
# Groq, used when every Gemini model is rate-limited (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-key

# Optional overrides
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant
