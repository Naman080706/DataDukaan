# Google Gemini API key (https://aistudio.google.com/apikey). Backend only, never exposed to the browser.
GEMINI_API_KEY=your-key-here
# Optional overrides
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
